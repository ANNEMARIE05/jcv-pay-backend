PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://jcv:jcv@localhost:5433/jcv_pay
JWT_SECRET=changez-cette-cle-en-production
JWT_EXPIRES=7d
# URL publique du backend (IP LAN du PC pour tests mobile, domaine HTTPS en production).
PUBLIC_BASE_URL=http://192.168.200.102:4000

# GeniusPay — https://geniuspay.ci/docs/api (Paramètres → API / Intégrations)
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
# Dashboard Intégrations : PUBLIC_KEY = clé sk_sandbox_… (X-API-Key / Bearer)
# SECRET_KEY = clé ss_sandbox_… (signature HMAC, pas X-API-Secret)
# Doc classique : pk_sandbox_… + sk_sandbox_…
GENIUSPAY_PUBLIC_KEY=sk_sandbox_
GENIUSPAY_SECRET_KEY=ss_sandbox_
# Alias : GENIUSPAY_API_KEY / GENIUSPAY_API_SECRET
# 1 = page checkout hébergée (sans payment_method, recommandé). 0 = moyen choisi dans l’app.
GENIUSPAY_USE_CHECKOUT=1
# whsec_… affiché une seule fois à la création du webhook (POST /webhooks).
GENIUSPAY_WEBHOOK_SECRET=
